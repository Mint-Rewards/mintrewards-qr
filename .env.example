# ---------------------------------------------------------------------------
# MintRewards QR — environment configuration
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Where this admin app is served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import into a client component, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Redirect destinations -------------------------------------------------
IOS_APP_STORE_URL=https://apps.apple.com/app/mint-rewards/id000000000
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.mintrewards

# --- QR tracking -----------------------------------------------------------
# !! BAKED INTO EVERY PRINTED STANDEE. A printed QR encodes this base URL
# !! permanently — changing it after a print run orphans those standees.
# !! Confirm the final production domain BEFORE the first print run.
QR_PUBLIC_BASE_URL=http://localhost:3000

# Where an invalid/unknown tracking code lands. Must be a real, public page —
# a scanner should never see an error.
QR_FALLBACK_URL=https://mintrewards.app

# --- Storage ---------------------------------------------------------------
STANDEE_TEMPLATE_STORAGE_PATH=templates
GENERATED_STANDEES_BUCKET=generated-standees
QR_IMAGES_BUCKET=qr-images

# --- Integration tests only (optional) ---
# Enables the standee-route test. Leave unset and that suite skips.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
